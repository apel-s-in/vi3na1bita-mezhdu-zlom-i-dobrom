[
  { "time": 7.873, "line": "Социальный грипп" },
  { "time": 9.767, "line": "косит души людей," },
  { "time": 11.52, "line": "симптом — равнодушие," },
  { "time": 13.38, "line": "диагноз — злодей." },
  { "time": 21.98, "line": "Мир — казино," },
  { "time": 23.297, "line": "где крупье всегда прав," },
  { "time": 25.35, "line": "и фишки краплёные," },
  { "time": 26.86, "line": "даже если ты граф!" },
  { "time": 28.397, "line": "От нищеты до дворцов —" },
  { "time": 30.403, "line": "бросок костей," },
  { "time": 32.157, "line": "тут правила пишет" },
  { "time": 33.843, "line": "хозяин мастей." },
  { "time": 35.757, "line": "Выигрыш — иллюзия," },
  { "time": 37.47, "line": "проигрыш — закон," },
  { "time": 39.023, "line": "где честность — мишень," },
  { "time": 40.81, "line": "а правда — позор." },
  { "time": 42.55, "line": "Ставки растут," },
  { "time": 44.203, "line": "но шансов-то — ноль," },
  { "time": 45.917, "line": "людей одурманил" },
  { "time": 47.657, "line": "тотальный контроль!" },
  { "time": 50.51, "line": "Вся жизнь — игра!" },
  { "time": 51.523, "line": "Крутись, рулетка, до утра!" },
  { "time": 54.013, "line": "Все ставки сделаны," },
  { "time": 55.2, "line": "ты проиграл ещё вчера!" },
  { "time": 57.88, "line": "Мы — поколение" },
  { "time": 59.023, "line": "без инструкций" },
  { "time": 60.25, "line": "к спасенью," },
  { "time": 61.397, "line": "но наши сердца —" },
  { "time": 62.73, "line": "это путь к воскрешенью!" },
  { "time": 71.82, "line": "Алчность — движок," },
  { "time": 73.363, "line": "толкает кошмар," },
  { "time": 75.197, "line": "ненависть — торф," },
  { "time": 76.663, "line": "разжигает пожар." },
  { "time": 78.17, "line": "Социальные лифты —" },
  { "time": 80.103, "line": "ржавые клетки," },
  { "time": 81.873, "line": "стабильность не купишь" },
  { "time": 83.663, "line": "за грош, за копейки..." },
  { "time": 85.297, "line": "Свобода — лишь эхо" },
  { "time": 86.975, "line": "в бетонной коробке," },
  { "time": 88.458, "line": "а равенство — сказка" },
  { "time": 90.448, "line": "в красивой обёртке." },
  { "time": 92.248, "line": "Где каждый второй" },
  { "time": 93.745, "line": "рубит голову с плеч," },
  { "time": 95.6, "line": "а третий мечтает" },
  { "time": 97.15, "line": "под начальника лечь!" },
  { "time": 100.259, "line": "Вся жизнь — игра!" },
  { "time": 101.244, "line": "Крутись, рулетка, до утра!" },
  { "time": 103.661, "line": "Все ставки сделаны," },
  { "time": 105.065, "line": "ты проиграл ещё вчера!" },
  { "time": 107.505, "line": "Мы — поколение" },
  { "time": 108.683, "line": "без инструкций к спасенью," },
  { "time": 111.132, "line": "но наши сердца —" },
  { "time": 112.359, "line": "это путь к воскрешенью!" },
  { "time": 114.555, "line": "Разбей эту тьму," },
  { "time": 116.168, "line": "вырвись из плена!" },
  { "time": 117.903, "line": "Сожги всё дотла," },
  { "time": 119.337, "line": "сними это бремя!" },
  { "time": 121.315, "line": "Крупье пусть смеётся," },
  { "time": 122.784, "line": "раздавая тузы," },
  { "time": 124.725, "line": "но мы-то все знаем," },
  { "time": 126.195, "line": "что в колоде козлы!" },
  { "time": 140.904, "line": "Что-то искрит," },
  { "time": 142.008, "line": "что-то зреет внутри," },
  { "time": 144.39, "line": "надежда на бунт" },
  { "time": 145.745, "line": "рвёт тишину на куски!" },
  { "time": 147.957, "line": "И может быть, завтра" },
  { "time": 149.639, "line": "рулетка сломается," },
  { "time": 151.287, "line": "крупье вдруг подавится," },
  { "time": 153.52, "line": "пирамида развалится!" },
  { "time": 156.665, "line": "Вся жизнь — игра!" },
  { "time": 158.222, "line": "Крутись, рулетка, до утра!" },
  { "time": 160.361, "line": "Все ставки сделаны," },
  { "time": 161.684, "line": "ты проиграл ещё вчера!" },
  { "time": 164.181, "line": "Мы — поколение" },
  { "time": 165.302, "line": "без инструкций к спасенью," },
  { "time": 167.661, "line": "но наши сердца —" },
  { "time": 168.887, "line": "это путь к воскрешенью!" },
  { "time": 171.179, "line": "Даже в аду" },
  { "time": 172.605, "line": "есть проблеск зари —" },
  { "time": 174.586, "line": "услышь голос правды" },
  { "time": 175.896, "line": "в своей ты груди!" },
  { "time": 177.926, "line": "Поднимется буря," },
  { "time": 179.576, "line": "восстанет волна!" },
  { "time": 181.345, "line": "И будет окончена" },
  { "time": 183.257, "line": "эта игра!" }
